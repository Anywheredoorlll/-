  "private_use_char_ratio_trigger": 0.01,
  "image_area_ratio_trigger": 0.60,
  "text_area_ratio_low": 0.01,
  "native_ocr_disagreement_trigger": 0.05,
  "ocr_retry_dpi": 400,
